/**
 * 全局样式
 * --------------------------------------------------
 * 所有页面共享这里的样式，各页面的 .wxss 可以覆盖或扩展
 * 优化要点：用 CSS 变量统一管理颜色、圆角、阴影，保证全站视觉一致
 */

/* 通用重置 */
page {
  background-color: #f5f6f8;
  font-size: 28rpx;
  color: #1a1a1a;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  /* CSS 变量：全局颜色体系 */
  --color-primary: #1989fa;
  --color-success: #07c160;
  --color-danger: #ee0a24;
  --color-warning: #fa8c16;
  --color-bg: #f5f6f8;
  --color-card: #ffffff;
  --color-text: #1a1a1a;
  --color-text-secondary: #666666;
  --color-text-hint: #999999;
  --color-border: #ececf0;
  /* 统一圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  /* 统一阴影 */
  --shadow-card: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-hover: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  /* ========== 适老化：全局字号缩放（无障碍） ==========
   * 通过 --font-scale 控制全局字号比例：
   *   小 = 0.9（视力好 / 信息密集偏好）
   *   中 = 1.0（默认）
   *   大 = 1.15（适老化，照顾视力下降用户）
   * 设置页通过给页面根容器加 class（font-small/font-medium/font-large）切换
   */
  --font-scale: 1;
}

/* 字号缩放：通过页面根容器的 class 覆盖变量 */
.font-small   { --font-scale: 0.9; }
.font-medium  { --font-scale: 1; }
.font-large   { --font-scale: 1.15; }

/* ========== 深色模式变量覆盖 ==========
 * 严格遵循 WCAG AA 对比度标准（正常文本 ≥ 4.5:1，大文本 ≥ 3:1）
 * 验证：背景 #1a1a1a 下
 *   text          #E0E0E0 → 12.0:1 ✓ AAA
 *   text-secondary #B0B0B0 → 7.4:1  ✓ AAA（原 #A0A0A0 升级）
 *   text-hint     #959595 → 4.93:1 ✓ AA （原 #707070 仅 2.9:1 ❌）
 *   primary       #3A9EFF → 6.86:1 ✓ AA
 */
.dark {
  --color-primary: #3a9eff;
  --color-success: #07c160;
  --color-danger: #ff4d4f;
  --color-warning: #fa8c16;
  --color-bg: #1a1a1a;
  --color-card: #2c2c2c;
  --color-text: #e0e0e0;
  --color-text-secondary: #B0B0B0;
  --color-text-hint: #959595;
  --color-border: #3a3a3a;
  --shadow-card: 0 2rpx 16rpx rgba(0, 0, 0, 0.3);
  --shadow-hover: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);
  --color-hover-row: #3a3a3a;
  background-color: #1a1a1a;
}

/* 去掉按钮默认边框和背景，方便自定义样式 */
button {
  border: none;
  outline: none;
}

button::after {
  border: none;
}

/* ========== 全局点击反馈（hover-class） ========== */
/* 卡片按压：轻微缩小 + 变暗 */
.hover-card {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 按钮按压：缩小 + 降低亮度 */
.hover-btn {
  transform: scale(0.96);
  opacity: 0.85;
}

/* 列表行按压：背景变灰 */
.hover-row {
  background: var(--color-hover-row, #f5f5f5) !important;
}

/* 药丸标签按压 */
.hover-pill {
  opacity: 0.7;
  transform: scale(0.95);
}

/* ========== 隐私授权弹窗（全局共享） ========== */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-card {
  width: 580rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  animation: privacyScaleIn 0.25s ease-out;
}

@keyframes privacyScaleIn {
  from { transform: scale(0.85); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  margin-bottom: 36rpx;
}

.privacy-link {
  color: #1989fa;
}

.privacy-buttons {
  display: flex;
  gap: 24rpx;
}

.privacy-btn-disagree {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #999999;
  background: #F5F7FA;
  border-radius: 16rpx;
}

.privacy-btn-agree {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #5EB3D9, #4AA3C9);
  border-radius: 16rpx;
  line-height: 1.5;
}
