/**
 * 刷题前设置页样式
 * --------------------------------------------------
 * 沿用首页蒂芙尼蓝 + 玄青配色，简约自然
 */

.setup-page {
  --color-bg: #E8F6F5;
  --color-card: #FFFFFF;
  --color-border: #C8E6E4;
  --color-text: #2D3A3A;
  --color-text-hint: #6B9F9C;
  --color-primary: #0ABAB5;

  padding: 0 48rpx;
  min-height: 100vh;
  background:
    radial-gradient(85% 50% at 88% -6%, rgba(10, 186, 181, 0.10) 0%, transparent 60%),
    linear-gradient(180deg, #EDF8F7 0%, #E8F6F5 50%, #E4F3F1 100%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ========== 通用区块 ========== */
.section {
  padding-top: 56rpx;
  animation: fadeInUp 0.5s ease both;
}

.section:nth-child(2) {
  animation-delay: 0.08s;
}

.section-label {
  display: flex;
  align-items: center;
  font-size: calc(28rpx * var(--font-scale, 1));
  font-weight: 500;
  color: var(--color-text-hint);
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}

/* 标签前的小竖线装饰 */
.section-label::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
  margin-right: 16rpx;
  opacity: 0.75;
}

/* ========== 标签芯片 ========== */
.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.chip {
  padding: 20rpx 40rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  font-size: calc(28rpx * var(--font-scale, 1));
  color: var(--color-text);
  /* 抬起复原时 Q 弹回弹（带轻微过冲） */
  transition: transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1),
              background 0.26s ease, border-color 0.26s ease,
              box-shadow 0.26s ease, color 0.26s ease;
  box-shadow: 0 2rpx 10rpx rgba(10, 186, 181, 0.05);
}

/* 按压反馈：瞬间缩小 + 轻微变暗（选中/未选中底色通用） */
.chip-hover {
  transform: scale(0.93);
  filter: brightness(0.96);
  transition-duration: 0.04s;
}

.chip-active {
  background: linear-gradient(135deg, #14CFC9 0%, #0ABAB5 100%);
  color: #FFFFFF;
  border-color: transparent;
  font-weight: 500;
  box-shadow: 0 6rpx 18rpx rgba(10, 186, 181, 0.32);
}

/* ========== 加载提示 ========== */
.loading-hint {
  font-size: calc(26rpx * var(--font-scale, 1));
  color: var(--color-text-hint);
  padding: 20rpx 0;
}

/* ========== 开始按钮 ========== */
.start-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-end;
  padding-bottom: 60rpx;
}

/* 选择摘要 */
.selection-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  animation: fadeInUp 0.5s ease 0.12s both;
}

.summary-label {
  font-size: calc(24rpx * var(--font-scale, 1));
  color: var(--color-text-hint);
  letter-spacing: 2rpx;
}

.summary-value {
  font-size: calc(26rpx * var(--font-scale, 1));
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 1rpx;
}

.start-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
  background: linear-gradient(135deg, #14CFC9 0%, #0AA8A3 100%);
  color: #FFFFFF;
  font-size: calc(32rpx * var(--font-scale, 1));
  font-weight: 600;
  border-radius: 20rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 28rpx rgba(10, 168, 163, 0.35);
  /* backwards（而非 both）：避免动画结束后占用 transform 导致按压 scale 失效 */
  animation: fadeInUp 0.5s ease 0.16s backwards;
  /* 抬起复原时 Q 弹回弹 */
  transition: transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1),
              opacity 0.26s ease, box-shadow 0.26s ease;
}

.start-btn-icon {
  font-size: 24rpx;
  line-height: 1;
}

/* 按压反馈：瞬间缩小 + 轻微变暗 */
.btn-hover {
  transform: scale(0.95);
  filter: brightness(0.96);
  transition-duration: 0.04s;
}

/* ========== 深色模式 ========== */
.setup-page.dark {
  /* 深色背景：显式覆盖日间硬编码渐变，否则深模式下会发白 */
  background:
    radial-gradient(85% 50% at 88% -6%, rgba(10, 186, 181, 0.10) 0%, transparent 60%),
    linear-gradient(180deg, #20244A 0%, #1A1A2E 45%, #15152B 100%);
  --color-bg: #1A1A2E;
  --color-card: #252540;
  --color-border: #353560;
  --color-text: #E8E8F0;
  --color-text-hint: #8888AA;
  --color-primary: #5EEAD4;
}

/* ============================================================
   新手引导（quiz-setup 承接样式）
   ------------------------------------------------------------
   仅在第二步「quiz-setup」时出现：
   - 全屏蒙层拦截非高亮区点击
   - Spotlight 镂空高亮「开始刷题」按钮
   - 单步气泡给出标题 / 描述 / 操作预期 / 进度 / 主按钮
   ============================================================ */

/* 蒙层：透明背景，仅用于拦截点击（高亮通过 box-shadow 投射） */
.ob-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3000;
  background: transparent;
  opacity: 1;
  transition: opacity 0.26s ease;
}
.ob-mask.closing {
  opacity: 0;
}

/* Spotlight：通过 box-shadow 投射巨大暗影制造「挖洞」效果 */
.ob-spotlight {
  position: absolute;
  border-radius: 20rpx;
  background: transparent;
  box-shadow: 0 0 0 9999rpx rgba(8, 18, 30, 0.78);
  animation: obSpotlightPulse 1.8s ease-in-out infinite;
  z-index: 3001;
}
@keyframes obSpotlightPulse {
  0%, 100% { box-shadow: 0 0 0 9999rpx rgba(8, 18, 30, 0.78); }
  50%      { box-shadow: 0 0 0 9999rpx rgba(8, 18, 30, 0.72); }
}

/* 气泡容器：居中或贴底 */
.ob-bubble-wrap {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 3002;
  pointer-events: none;
}
.ob-bubble-wrap.centered {
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  justify-content: center;
}
.ob-bubble-wrap.with-target {
  bottom: 32rpx;
  display: flex;
  justify-content: center;
}

/* 单步气泡卡片 */
.ob-bubble {
  pointer-events: auto;
  width: 600rpx;
  max-width: 88%;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 24rpx 60rpx rgba(8, 18, 30, 0.22);
  padding: 36rpx 32rpx 28rpx;
  animation: obBubbleIn 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  position: relative;
  overflow: hidden;
}
@keyframes obBubbleIn {
  0%   { opacity: 0; transform: translateY(24rpx) scale(0.92); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* 头部 */
.ob-bubble-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.ob-bubble-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(20rpx);
  opacity: 0.55;
  z-index: 0;
}
.ob-bubble-orb-a {
  width: 140rpx;
  height: 140rpx;
  background: #14CFC9;
  left: -40rpx;
  top: -60rpx;
}
.ob-bubble-orb-b {
  width: 100rpx;
  height: 100rpx;
  background: #0ABAB5;
  right: -20rpx;
  top: -30rpx;
}
.ob-bubble-step {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: #0ABAB5;
  background: rgba(10, 186, 181, 0.10);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  letter-spacing: 1rpx;
}
.ob-bubble-icon {
  position: relative;
  z-index: 1;
  font-size: 44rpx;
  margin-left: auto;
  line-height: 1;
}

/* 主体文案 */
.ob-bubble-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #2D3A3A;
  margin-bottom: 12rpx;
}
.ob-bubble-desc {
  display: block;
  font-size: 26rpx;
  color: #6B9F9C;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

/* 操作预期条 */
.ob-bubble-expect {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(10, 186, 181, 0.08);
  border-left: 4rpx solid #0ABAB5;
  border-radius: 8rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 22rpx;
}
.ob-bubble-expect-icon {
  font-size: 22rpx;
  color: #0ABAB5;
  font-weight: 600;
  line-height: 1.5;
}
.ob-bubble-expect-text {
  flex: 1;
  font-size: 24rpx;
  color: #2D3A3A;
  line-height: 1.5;
}

/* 进度条 */
.ob-bubble-progress {
  width: 100%;
  height: 8rpx;
  background: rgba(10, 186, 181, 0.10);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
}
.ob-bubble-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #14CFC9 0%, #0ABAB5 100%);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

/* 操作区 */
.ob-bubble-actions {
  display: flex;
  gap: 16rpx;
}
.ob-bubble-primary {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  background: linear-gradient(135deg, #14CFC9 0%, #0AA8A3 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 18rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(10, 168, 163, 0.30);
}

/* 当引导激活时，给被高亮的开始按钮叠加一层光环提示 */
.ob-spotlight-target {
  position: relative;
}

/* ========== 深色模式覆盖 ========== */
.setup-page.dark .ob-bubble {
  background: #252540;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.55);
}
.setup-page.dark .ob-bubble-orb-a { background: #5EEAD4; }
.setup-page.dark .ob-bubble-orb-b { background: #14CFC9; }
.setup-page.dark .ob-bubble-step {
  color: #5EEAD4;
  background: rgba(94, 234, 212, 0.12);
}
.setup-page.dark .ob-bubble-title { color: #E8E8F0; }
.setup-page.dark .ob-bubble-desc { color: #8888AA; }
.setup-page.dark .ob-bubble-expect {
  background: rgba(94, 234, 212, 0.10);
  border-left-color: #5EEAD4;
}
.setup-page.dark .ob-bubble-expect-icon { color: #5EEAD4; }
.setup-page.dark .ob-bubble-expect-text { color: #E8E8F0; }
.setup-page.dark .ob-bubble-progress {
  background: rgba(94, 234, 212, 0.12);
}
.setup-page.dark .ob-bubble-progress-bar {
  background: linear-gradient(90deg, #5EEAD4 0%, #14CFC9 100%);
}

/* ========== 小屏自适应 ========== */
@media (max-width: 360px) {
  .ob-bubble {
    width: 92%;
    padding: 32rpx 28rpx 24rpx;
  }
  .ob-bubble-title { font-size: 32rpx; }
  .ob-bubble-desc { font-size: 25rpx; }
}
