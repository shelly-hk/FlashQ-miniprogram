/**
 * 自主题库刷题页样式
 * 复用 quiz 页的视觉风格
 * --------------------------------------------------
 */

/* ========== 整页容器 ==========
   不再锁死 height:100vh，也不在 view 上做 overflow 滚动
   （小程序普通 view 无法可靠地作为滚动容器），改由 page 本身滚动。
   【深色模式整页无法操作的根因】
   原本两层都是 absolute + overflow-y:auto 各自滚动：深色模式下用户看见的是
   深色层（z-index:2），其 scrollTop 恒为 0，滑动只滚动了看不见的浅色层，
   长题干/长解析下方内容与底部按钮永远够不到。 */
.custom-container {
  position: relative;
  min-height: 100vh;
  background: var(--color-bg);
}

/* ========== BGM 开关按钮（音符） ==========
   fixed：容器高度由内容撑开后页面会滚动，按钮需常驻右上角 */
.bgm-toggle-btn {
  position: fixed;
  top: 28rpx;
  right: 116rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  transition: background 0.25s ease, border-color 0.25s ease;
}

/* 深色模式：浅色半透明圆底 + 亮描边（与右侧主题按钮的夜间观感一致），
   避免深色页面上按钮糊成一片 */
.bgm-toggle-btn.night {
  background: rgba(232, 232, 240, 0.16);
  border: 2rpx solid rgba(232, 232, 240, 0.4);
}

/* 开启时变为深色，代表正在播放 BGM */
.bgm-toggle-btn.on {
  background: rgba(26, 26, 46, 0.85);
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.3);
}

/* 深色模式开启态：琥珀色描边 + 光晕，明确"正在播放" */
.bgm-toggle-btn.night.on {
  border-color: rgba(255, 209, 102, 0.6);
  box-shadow: 0 0 20rpx rgba(255, 183, 77, 0.35), 0 4rpx 16rpx rgba(26, 26, 46, 0.4);
}

/* 音符图标：日间深琥珀 / 深色模式亮琥珀，两种模式下都清晰可见
   （原 🎵 emoji 未设显式颜色，部分设备渲染为深色字形，深色模式下看不清） */
.bgm-toggle-icon {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  color: #C77800;
}

.bgm-toggle-btn.night .bgm-toggle-icon {
  color: #FFB74D;
}

.bgm-toggle-btn.on .bgm-toggle-icon {
  color: #FFD166;
  animation: bgmSpin 3s linear infinite;
}

@keyframes bgmSpin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* ========== 唱片杆（唱臂）==========
   与首页 home.wxss 完全一致：
   唱片圆心 = 距右 152rpx / 距顶 64rpx（按钮 right:116 + 半径36、top:28 + 半径36）
   支点圆心 = 唱片正上方「距右 152rpx / 距顶 14rpx」，杆长 50rpx
   —— 停止态 rotate(62deg)：整根杆离唱片边缘最近 44.1rpx > 半径 36(+2rpx 描边)，明显抬离唱片；
      抬向左侧（页面内侧），避开右侧的主题切换按钮（本页 right:32，占 32~104rpx）
   —— 播放态 rotate(-34deg)：唱头落在距圆心 29rpx 处（约 0.8R，唱片的纹路上），最右侧约 118rpx
   只在 .bgm-arm 上写 transform，内部零件随容器一起转，不额外叠加旋转 */
.bgm-arm {
  position: fixed;
  top: 4rpx;                /* 支点圆心 = 此处 + 10rpx，与按钮 top:28 配套（圆心 64 - 杆长 50） */
  right: 142rpx;            /* 142 + 10(支点半径) = 152，与唱片圆心同一条竖线 */
  z-index: 101;             /* 高于唱片按钮(100)，唱臂压在唱片之上 */
  width: 20rpx;
  height: 60rpx;
  transform-origin: 10rpx 10rpx;   /* 支点圆心 */
  transform: rotate(62deg);        /* 默认：抬起 */
  transition: transform 0.55s cubic-bezier(0.32, 1.24, 0.58, 1);
}

/* 播放：唱臂落下 */
.bgm-arm.on {
  transform: rotate(-34deg);
}

/* 配重（支点后端的配重块，随杆一起转） */
.bgm-arm-weight {
  position: absolute;
  left: 6rpx;
  top: 1rpx;
  width: 8rpx;
  height: 10rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #B9BFCE 0%, #F2F4F8 45%, #8F95A8 100%);
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.25);
}

/* 杆身：金属渐变，浅色/深色背景下都能看清 */
.bgm-arm-rod {
  position: absolute;
  left: 7rpx;
  top: 10rpx;
  width: 6rpx;
  height: 44rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #C9CEDB 0%, #F5F7FA 40%, #A6ACBD 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.28);
}

/* 唱头（搭在唱片上的那一头） */
.bgm-arm-head {
  position: absolute;
  left: 4rpx;
  top: 46rpx;
  width: 12rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #E9ECF4 0%, #8E94A8 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.32);
}

/* 支点转轴 */
.bgm-arm-pivot {
  position: absolute;
  left: 3rpx;
  top: 3rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFFFFF 0%, #D7DBE6 45%, #8F95A8 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

/* 播放态：唱头带一点琥珀色光晕，和唱片的琥珀描边呼应 */
.bgm-arm.on .bgm-arm-head {
  background: linear-gradient(180deg, #FFE1A6 0%, #E0A63C 100%);
  box-shadow: 0 0 8rpx rgba(255, 183, 77, 0.55), 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

/* 深色模式：唱臂整体调暗一档并保留金属高光，避免杆子在深底上过于刺眼 */
.bgm-arm.night .bgm-arm-weight {
  background: linear-gradient(90deg, #5F657A 0%, #BFC4D2 45%, #4E5468 100%);
}
.bgm-arm.night .bgm-arm-rod {
  background: linear-gradient(90deg, #6E7488 0%, #C7CCDA 40%, #565C70 100%);
}
.bgm-arm.night .bgm-arm-head {
  background: linear-gradient(180deg, #C3C8D6 0%, #6C7286 100%);
}
.bgm-arm.night .bgm-arm-pivot {
  background: radial-gradient(circle at 35% 30%, #E8EAF2 0%, #A9AFC0 45%, #5C6276 100%);
  border-color: rgba(255, 255, 255, 0.35);
}

/* ========== 深色模式切换按钮 ==========
   fixed：与 BGM 按钮同理，页面滚动时保持常驻右上角 */
.theme-toggle-btn {
  position: fixed;
  top: 28rpx;
  right: 32rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.theme-icon {
  font-size: 36rpx;
}
.custom-page.theme-layer {
  padding: 24rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* 浅色层：保持正常文档流。
   绝对定位元素不参与父容器的滚动高度计算，必须由这一层真实撑开容器高度，
   长题干/长解析才能滚动查看。 */
.custom-page.light-layer {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

/* 深色层（clip-path 圆形裁切，纯视觉层，常驻 DOM）
   绝对定位覆盖在浅色层上；不写 bottom:0，高度由自身内容撑开（min-height 一屏），
   与浅色层等高，随 page 一起滚动，视觉位置与可点击位置始终同步。 */
.custom-page.dark-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  min-height: 100vh;
  transition: clip-path 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              -webkit-clip-path 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: none;
}

/* 钉动画起点用：无过渡地把圆形圆心移到触摸点（与随机刷题页一致） */
.custom-page.dark-layer.no-transition {
  transition: none !important;
}

/* ========== 浅色主题 ========== */
.custom-page {
  --color-primary: #1989fa;
  --color-text: #1a1a1a;
  --color-text-secondary: #666666;
  --color-text-hint: #999999;
  --color-bg: #f5f6f8;
  --color-card: #ffffff;
  --color-border: #ececf0;

  /* 顶部微光泽，增加层次 */
  background:
    radial-gradient(90% 40% at 50% -8%, rgba(255, 255, 255, 0.7) 0%, transparent 65%),
    linear-gradient(180deg, #F7F9FC 0%, #F5F6F8 45%, #F2F4F8 100%);
}

/* ========== 深色主题 ========== */
.custom-page.dark {
  --color-primary: #4A9FE0;
  --color-text: #E8E8F0;
  --color-text-secondary: #AABBDD;
  --color-text-hint: #7788AA;
  --color-bg: #1A1A2E;
  --color-card: #252540;
  --color-border: #353560;

  background: var(--color-bg);
}

.custom-page.dark .filter-pill {
  background: #353560;
  color: #E8E8F0;
}

.custom-page.dark .filter-pill.pill-active {
  background: #4A9FE0;
  color: #ffffff;
}

.custom-page.dark .opt-correct {
  background: rgba(94, 234, 212, 0.12);
  border-color: #5EEAD4;
}

.custom-page.dark .opt-wrong {
  background: rgba(255, 107, 107, 0.12);
  border-color: #FF6B6B;
}

.custom-page.dark .result-correct {
  background: rgba(94, 234, 212, 0.12);
  color: #5EEAD4;
}

.custom-page.dark .result-wrong {
  background: rgba(255, 107, 107, 0.12);
  color: #FF6B6B;
}

.custom-page.dark .category-tag,
.custom-page.dark .source-tag {
  background: rgba(74, 159, 224, 0.12);
}

.custom-page.dark .opt-selected {
  background: rgba(74, 159, 224, 0.12);
}

.custom-page.dark .next-btn {
  box-shadow: 0 8rpx 24rpx rgba(74, 159, 224, 0.3);
}

/* ========== 分类筛选条 ========== */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.filter-label {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.filter-arrow {
  font-size: 28rpx;
  color: var(--color-primary);
  transform: rotate(90deg);
  transition: transform 0.25s;
}

.filter-arrow.arrow-up {
  transform: rotate(-90deg);
}

/* ========== 自主题库进度条 ========== */
/* 克制风格：细线条 + 小字号文字，避免抢夺题干视觉焦点 */
.custom-progress {
  margin: -8rpx 0 24rpx;
  padding: 0 16rpx;
  animation: fadeIn 0.35s ease;
}

.progress-meta {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.progress-current {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 6rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
  opacity: 0.65;
}

.progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
  transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 分类筛选面板 */
.filter-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.filter-pill {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.filter-pill.pill-active {
  background: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
}

/* ========== 来源行 ========== */
.source-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  background: #f0f4ff;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-primary);
}

/* ========== 多选题 ========== */
.multi-tag {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #ff9a56, #ff6b6b);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.checkbox-letter {
  border-radius: 50% !important;
  border: 3rpx solid var(--color-border);
  color: var(--color-text-hint);
}

.opt-selected .checkbox-letter {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.multi-submit-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 0 8rpx;
  gap: 20rpx;
}

.multi-hint {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.multi-submit-btn {
  flex: 1;
  max-width: 320rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #4A9DF5 0%, #1989FA 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(25, 137, 250, 0.3);
}

.multi-submit-btn.btn-disabled {
  background: var(--color-border);
  color: var(--color-text-hint);
}

/* ========== 收藏按钮（底部操作区，位于「下一题」左侧） ========== */
.fav-btn {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--color-border);
  transition: all 0.2s;
}

.fav-btn.fav-active {
  color: var(--color-warning);
  border-color: var(--color-warning);
  background: #fff7e6;
}

/* ========== 统计条 ========== */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--color-border);
}

/* ========== 空状态 ========== */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-block;
  background: linear-gradient(135deg, #4A9DF5 0%, #1989FA 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 48rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.3);
}

/* ========== 加载状态 ========== */
.loading-state {
  text-align: center;
  padding: 120rpx 0;
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: dot-bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

/* ========== 题目卡片 ========== */
.question-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.source-tag {
  display: inline-flex;
  align-items: center;
  background: #f0f4ff;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 24rpx;
}

.source-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.source-name {
  font-size: 22rpx;
  color: var(--color-primary);
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.question-content {
  font-size: calc(36rpx * var(--font-scale, 1));
  font-weight: 500;
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* ========== 选项 ========== */
.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.opt-selected {
  border-color: var(--color-primary);
  background: #f0f4ff;
}

.opt-correct {
  border-color: var(--color-success);
  background: #e7f8ee;
}

.opt-wrong {
  border-color: var(--color-danger);
  background: #fff0f0;
  /* 红色摇头动画：旋转 + 轻微位移，像人在摇头 */
  animation: headShake 0.55s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  transform-origin: center bottom;
}

.option-letter {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.opt-selected .option-letter {
  background: var(--color-primary);
  color: #ffffff;
}

.opt-correct .option-letter {
  background: var(--color-success);
  color: #ffffff;
}

.opt-wrong .option-letter {
  background: var(--color-danger);
  color: #ffffff;
}

.option-text {
  flex: 1;
  font-size: calc(32rpx * var(--font-scale, 1));
  color: var(--color-text);
}

.option-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.badge-correct {
  background: var(--color-success);
  color: #ffffff;
}

.badge-wrong {
  background: var(--color-danger);
  color: #ffffff;
}

/* ========== 反馈区 ========== */
.feedback {
  margin-top: 32rpx;
}

.result-bar {
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-correct {
  background: #e7f8ee;
  color: var(--color-success);
}

.result-wrong {
  background: #fff0f0;
  color: var(--color-danger);
}

.countdown-tag {
  float: right;
  font-size: 26rpx;
  font-weight: 400;
  opacity: 0.85;
}

.explanation-box {
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  border-left: 6rpx solid var(--color-primary);
}

.explanation-label {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-bottom: 8rpx;
  display: block;
}

.explanation-text {
  font-size: calc(28rpx * var(--font-scale, 1));
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ========== 底部操作区 ========== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 48rpx;
}

.prev-btn {
  color: var(--color-primary);
  font-size: 30rpx;
  padding: 18rpx 36rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  background: var(--color-card);
  font-weight: 500;
}

.next-btn {
  flex: 1;
  max-width: 400rpx;
  text-align: center;
  background: linear-gradient(135deg, #4A9DF5 0%, #1989FA 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: var(--radius-md);
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.35);
}

.next-btn-skip {
  background: var(--color-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  box-shadow: none;
  font-size: 30rpx;
  padding: 26rpx 0;
  font-weight: 500;
}

/* ========== 答题反馈动画（与 quiz 页一致） ========== */

/* 摇头动画（答错反馈）：左右旋转 + 轻微位移 */
@keyframes headShake {
  0%   { transform: rotate(0deg)    translateX(0); }
  15%  { transform: rotate(-8deg)   translateX(-6rpx); }
  30%  { transform: rotate(7deg)    translateX(6rpx); }
  45%  { transform: rotate(-5deg)   translateX(-4rpx); }
  60%  { transform: rotate(4deg)    translateX(4rpx); }
  75%  { transform: rotate(-2deg)   translateX(0); }
  100% { transform: rotate(0deg)    translateX(0); }
}

/* 答对粒子爆开（纯视觉固定层，不受双层主题影响） */
.particle-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 本轮刷完弹窗（与 quiz 页视觉一致） ========== */
.review-done-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(10, 30, 50, 0.45);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease;
}
.review-done-card {
  width: 560rpx;
  background: var(--color-card, #fff);
  border-radius: 28rpx;
  padding: 64rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 24rpx 64rpx rgba(10, 30, 50, 0.25);
  animation: reviewDoneIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes reviewDoneIn {
  from { transform: scale(0.85); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}
.review-done-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F6FE 0%, #D6EBF9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 8rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9), 0 8rpx 24rpx rgba(43, 108, 176, 0.15);
}
.review-done-title { font-size: 34rpx; font-weight: 600; color: var(--color-text, #2D3A3A); }
.review-done-desc { font-size: 26rpx; color: var(--color-text-secondary, #999); }
.review-done-btns { display: flex; gap: 24rpx; margin-top: 20rpx; }
.review-done-btn {
  padding: 20rpx 48rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: linear-gradient(135deg, #3D82D0 0%, #2B6CB0 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(43, 108, 176, 0.3);
}
.review-done-back {
  background: transparent;
  border: 2rpx solid var(--color-border, #ddd);
  color: var(--color-text-secondary, #999);
}

.particle-burst {
  position: relative;
  width: 0;
  height: 0;
}

.particle-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 40rpx;
  height: 40rpx;
  margin: -20rpx 0 0 -20rpx;
  border-radius: 50%;
  border: 6rpx solid #10B981;
  opacity: 0;
  animation: ringExpand 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  box-sizing: border-box;
}

.particle-ring-2 {
  animation-delay: 0.15s;
  border-color: #5EEAD4;
  border-width: 4rpx;
}

@keyframes ringExpand {
  0%   { transform: scale(0);    opacity: 0.9; }
  60%  { opacity: 0.5; }
  100% { transform: scale(9);    opacity: 0; }
}

.particle {
  position: absolute;
  top: 0;
  left: 0;
  border-radius: 50%;
  opacity: 0;
  animation: particleBurst 0.9s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  animation-delay: var(--delay, 0s);
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.6);
}

@keyframes particleBurst {
  0% {
    opacity: 1;
    transform: rotate(var(--angle, 0deg)) translateY(0) scale(1);
  }
  70% {
    opacity: 0.85;
  }
  100% {
    opacity: 0;
    transform: rotate(var(--angle, 0deg)) translateY(calc(-1 * var(--distance, 240rpx))) scale(0.25);
  }
}
