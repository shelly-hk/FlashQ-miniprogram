<!--
  错题本页面
  --------------------------------------------------
  布局：Tab切换 → 筛选标签 → 统计标题 → 错题卡片列表 → 分页控件 → 空状态
-->

<view class="wrong-page {{darkMode ? 'dark' : ''}} font-{{fontScale}}">

  <!-- ========== Tab 切换 ========== -->
  <view class="wrong-tabs">
    <view class="wrong-tab {{activeTab === 'public' ? 'tab-active' : ''}}" data-tab="public" bindtap="onTabChange" hover-class="hover-pill" hover-stay-time="100">
      公共题库错题
    </view>
    <view class="wrong-tab {{activeTab === 'custom' ? 'tab-active' : ''}}" data-tab="custom" bindtap="onTabChange" hover-class="hover-pill" hover-stay-time="100">
      自主题库错题
    </view>
  </view>

  <!-- ========== 公共题库二级分类（随机刷题 / 代码题库） ========== -->
  <view wx:if="{{activeTab === 'public'}}" class="sub-tabs">
    <view
      wx:for="{{publicSubTabs}}"
      wx:key="id"
      class="sub-tab {{activeQuizType === item.id ? 'sub-tab-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onQuizTypeChange"
      hover-class="hover-pill"
      hover-stay-time="100"
    >{{item.name}}</view>
  </view>

  <!-- ========== 筛选（科目/分类）：点击展开面板，参考刷题页 ========== -->
  <view class="filter-bar" wx:if="{{filterTabs.length > 0}}">
    <view class="filter-current" bindtap="onToggleFilter" hover-class="hover-row" hover-stay-time="100">
      <text class="filter-icon">📖</text>
      <text class="filter-text">{{activeFilterName}}</text>
      <text class="filter-arrow {{showFilter ? 'arrow-up' : ''}}">›</text>
    </view>

    <!-- 展开后的筛选面板 -->
    <view wx:if="{{showFilter}}" class="filter-panel">
      <view class="filter-section">
        <text class="filter-label">{{activeTab === 'public' ? '按科目筛选' : '按分类筛选'}}</text>
        <view class="filter-options">
          <view
            wx:for="{{filterTabs}}"
            wx:key="id"
            class="filter-pill {{activeFilter === item.id ? 'pill-active' : ''}}"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            bindtap="onFilterChange"
            hover-class="chip-hover"
            hover-stay-time="100"
          >{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 顶部统计 ========== -->
  <view class="header-bar" wx:if="{{list.length > 0}}">
    <text class="header-total">共 {{total}} 道错题</text>
    <view class="header-right">
      <text wx:if="{{!manageMode}}" class="header-hint">点击题目查看详情</text>
      <view class="manage-btn" bindtap="onToggleManage" hover-class="hover-btn" hover-stay-time="100">{{manageMode ? '完成' : '管理'}}</view>
    </view>
  </view>

  <!-- ========== 批量操作工具栏（管理模式，内嵌式，与收藏页一致） ========== -->
  <view class="batch-bar" wx:if="{{manageMode && list.length > 0}}">
    <view class="batch-select-all" bindtap="onToggleAll" hover-class="hover-pill" hover-stay-time="100">
      {{allSelected ? '取消全选' : '全选'}}
    </view>
    <view class="batch-fav {{selectedAllFavorited ? 'batch-unfavorite' : ''}} {{selectedCount === 0 ? 'btn-disabled' : ''}}" catchtap="onBatchFavorite" hover-class="hover-pill" hover-stay-time="100">
      <text wx:if="{{selectedAllFavorited}}" class="batch-fav-icon">★</text>
      <text wx:else class="batch-fav-icon">☆</text>
      <text>{{selectedAllFavorited ? '取消收藏' : '收藏'}}{{selectedCount > 0 ? '(' + selectedCount + ')' : ''}}</text>
    </view>
    <view class="batch-delete {{selectedCount === 0 ? 'btn-disabled' : ''}}" catchtap="onBatchDelete" hover-class="hover-pill" hover-stay-time="100">
      删除{{selectedCount > 0 ? '(' + selectedCount + ')' : ''}}
    </view>
  </view>

  <!-- ========== 错题列表 ========== -->
  <view class="wrong-list {{manageMode ? 'manage-active' : ''}}">

    <view
      wx:for="{{list}}"
      wx:key="id"
      class="wrong-card {{expandedId === item.id ? 'expanded' : ''}} {{manageMode && selectedIds[item.id] ? 'item-selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="{{manageMode ? 'onToggleSelect' : 'onQuestionTap'}}"
      hover-class="hover-card"
      hover-stay-time="100"
    >
      <!-- 管理模式下的选择指示器 -->
      <view wx:if="{{manageMode}}" class="select-indicator {{selectedIds[item.id] ? 'checked' : ''}}">
        <text wx:if="{{selectedIds[item.id]}}" class="check-icon">✓</text>
      </view>

      <!-- 题目头部：科目标签 + 难度 + 移除按钮 -->
      <view class="card-top">
        <view class="card-tags">
          <!-- 题目类型标签（代码题） -->
          <text class="tag tag-type" wx:if="{{activeTab === 'public' && item.quizType === 'code'}}">代码题</text>
          <text class="tag tag-subject" wx:if="{{activeTab === 'public'}}">{{item.subjectName}}</text>
          <text class="tag tag-subject" wx:if="{{activeTab === 'custom'}}">{{item.categoryName || '其他'}}</text>
          <text class="tag tag-difficulty">难度{{item.difficulty === 1 ? '·初' : item.difficulty === 2 ? '·中' : '·高'}}</text>
          <text wx:if="{{item.isFavorited}}" class="tag tag-favorited">⭐ 已收藏</text>
        </view>
        <!-- 收藏 + 移除：仅非管理模式显示 -->
        <view wx:if="{{!manageMode}}" class="card-actions">
          <view class="fav-btn {{item.isFavorited ? 'fav-active' : ''}}" data-id="{{item.id}}" data-index="{{index}}" catchtap="onToggleFavorite" hover-class="hover-btn" hover-stay-time="100">{{item.isFavorited ? '已收藏' : '收藏'}}</view>
          <view class="remove-btn" data-id="{{item.id}}" catchtap="onDeleteWrong" hover-class="hover-btn" hover-stay-time="100">移除</view>
        </view>
      </view>

      <!-- 题干（始终显示） -->
      <view class="card-question">{{item.content}}</view>

      <!-- 展开后显示的内容 -->
      <block wx:if="{{expandedId === item.id}}">

        <!-- 选项列表 -->
        <view class="card-options">
          <view
            wx:for="{{item.optionsParsed}}"
            wx:for-item="opt"
            wx:key="letter"
            class="card-option {{
              opt.letter === item.correctAnswer ? 'opt-correct' :
              opt.letter === item.userAnswer ? 'opt-wrong' : ''
            }}"
          >
            <text class="opt-text">{{opt.text}}</text>
            <text wx:if="{{opt.letter === item.correctAnswer}}" class="opt-mark opt-mark-correct">正确</text>
            <text wx:elif="{{opt.letter === item.userAnswer}}" class="opt-mark opt-mark-wrong">你的选择</text>
          </view>
        </view>

        <!-- 解析 -->
        <view class="card-explanation">
          <text class="explanation-label">解析</text>
          <text class="explanation-text">{{item.explanation || '暂无解析'}}</text>
        </view>

      </block>

      <!-- 收起状态：显示简短信息 -->
      <view wx:else class="card-brief">
        <text class="brief-wrong">你选了 {{item.userAnswer}}</text>
        <text class="brief-correct">正确答案 {{item.correctAnswer}}</text>
      </view>

    </view>

  </view>

  <!-- ========== 加载提示 ========== -->
  <view wx:if="{{loading}}" class="loading-tip">
    <text>加载中...</text>
  </view>

  <!-- ========== 分页控件 ========== -->
  <view wx:if="{{!loading && totalPages > 0}}" class="pagination">
    <view class="page-btn {{page <= 1 ? 'btn-disabled' : ''}}" bindtap="onPrevPage" hover-class="hover-btn" hover-stay-time="100">上一页</view>
    <view class="page-info">{{page}} / {{totalPages}}</view>
    <view class="page-btn {{page >= totalPages ? 'btn-disabled' : ''}}" bindtap="onNextPage" hover-class="hover-btn" hover-stay-time="100">下一页</view>
  </view>

  <!-- ========== 空状态 ========== -->
  <view wx:if="{{!loading && list.length === 0}}" class="empty-state">
    <!-- 品牌 SVG 插画：一份空白的错题本 + 飘动的星火 -->
    <view class="empty-illust">
      <view class="empty-illust-ring"></view>
      <view class="empty-illust-ring empty-illust-ring-2"></view>
      <view class="empty-illust-book">
        <view class="empty-illust-spine"></view>
        <view class="empty-illust-lines">
          <view class="empty-illust-line"></view>
          <view class="empty-illust-line short"></view>
          <view class="empty-illust-line"></view>
        </view>
        <view class="empty-illust-mark">✓</view>
      </view>
      <text class="empty-illust-spark spark-1">✦</text>
      <text class="empty-illust-spark spark-2">✦</text>
      <text class="empty-illust-spark spark-3">•</text>
    </view>
    <view class="empty-title">{{activeTab === 'public' ? '错题本还是空白页' : '自主题库还没有错题'}}</view>
    <view class="empty-text">{{activeTab === 'public' ? '保持正确率，错题会自动汇集到这里方便回顾' : '去自主题库刷几题，错了我们替你记着'}}</view>
    <view class="empty-btn" bindtap="onPracticeAgain" hover-class="hover-btn" hover-stay-time="100">
      <text class="empty-btn-icon">📝</text>
      <text>去刷题</text>
    </view>
  </view>

  <!-- 管理模式底部留白 -->
  <view wx:if="{{manageMode && list.length > 0}}" style="height: 40rpx;"></view>

</view>
