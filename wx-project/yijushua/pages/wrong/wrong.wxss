/**
 * 错题本页面样式
 * --------------------------------------------------
 * 优化：卡片统一阴影圆角、字号层级清晰、解析区左侧蓝色边框
 */

/* ========== 色彩体系（错题本局部覆盖） ==========
 * 主色：捣蓝色  #2B6CB0 → 做主交互色
 * 辅色：清水蓝  #DCEEF7 → 做背景
 */
.wrong-page {
  --color-primary: #2B6CB0;
  --color-text: #1A3A5C;
  --color-text-secondary: #4A7BA8;
  --color-text-hint: #6B9BC4;
  --color-bg: #DCEEF7;
  --color-card: #FFFFFF;
  --color-border: #B8DCF0;

  min-height: 100vh;
  background:
    radial-gradient(85% 40% at 50% -8%, rgba(255, 255, 255, 0.5) 0%, transparent 62%),
    linear-gradient(180deg, #E6F2FA 0%, #DCEEF7 45%, #D9EBF6 100%);
  padding: 24rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* ========== Tab 切换（分段选择器） ========== */
.wrong-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 18rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

/* ========== 筛选（科目/分类）：收起态筛选条 + 点击展开面板（参考刷题页） ========== */
.filter-bar {
  margin-bottom: 24rpx;
}

/* 收起态：当前筛选条 */
.filter-current {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 20rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 108, 176, 0.08);
  border: 1rpx solid rgba(43, 108, 176, 0.22);
}

.filter-icon {
  font-size: 30rpx;
  line-height: 1;
}

.filter-text {
  font-size: calc(28rpx * var(--font-scale, 1));
  color: var(--color-primary);
  font-weight: 500;
}

.filter-arrow {
  font-size: 28rpx;
  color: var(--color-primary);
  transform: rotate(90deg);
  transition: transform 0.25s;
}

.filter-arrow.arrow-up {
  transform: rotate(-90deg);
}

/* 展开态：筛选面板 */
.filter-panel {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 108, 176, 0.08);
  border: 1rpx solid rgba(43, 108, 176, 0.22);
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.filter-section {
  margin-bottom: 0;
}

/* 小节标题：带主色竖线装饰 */
.filter-label {
  display: flex;
  align-items: center;
  font-size: calc(26rpx * var(--font-scale, 1));
  font-weight: 500;
  color: var(--color-text-hint);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.filter-label::before {
  content: '';
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
  margin-right: 14rpx;
  opacity: 0.75;
}

/* 筛选项：换行平铺（与刷题页 filter-options 一致） */
.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.filter-pill {
  padding: 18rpx 36rpx;
  background: var(--color-bg);
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  font-size: calc(27rpx * var(--font-scale, 1));
  color: var(--color-text-secondary);
  /* 抬起复原时 Q 弹回弹（带轻微过冲） */
  transition: transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1),
              background 0.26s ease, border-color 0.26s ease,
              box-shadow 0.26s ease, color 0.26s ease;
}

/* 按压反馈：瞬间缩小 + 轻微变暗 */
.chip-hover {
  transform: scale(0.93);
  filter: brightness(0.96);
  transition-duration: 0.04s;
}

.filter-pill.pill-active {
  background: linear-gradient(135deg, #3D82D0 0%, #2B6CB0 100%);
  color: #ffffff;
  border-color: transparent;
  font-weight: 500;
  box-shadow: 0 6rpx 18rpx rgba(43, 108, 176, 0.32);
}

/* ========== 分页控件 ========== */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 32rpx 0 16rpx;
}

.page-btn {
  padding: 16rpx 40rpx;
  font-size: calc(28rpx * var(--font-scale, 1));
  border-radius: 32rpx;
  background: var(--color-card);
  color: var(--color-primary);
  border: 2rpx solid rgba(43, 108, 176, 0.35);
  transition: all 0.2s;
  font-weight: 500;
}

.page-btn.btn-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.page-info {
  font-size: calc(28rpx * var(--font-scale, 1));
  color: var(--color-text);
  font-weight: 600;
}

.wrong-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: calc(29rpx * var(--font-scale, 1));
  border-radius: 12rpx;
  background: transparent;
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.25s;
  font-weight: 500;
}

.wrong-tab.tab-active {
  background: linear-gradient(135deg, #3D82D0 0%, #2B6CB0 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(43, 108, 176, 0.3);
}

/* ========== 公共题库二级分类（细分随机/代码） ========== */
.sub-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.sub-tab {
  padding: 12rpx 26rpx;
  font-size: calc(26rpx * var(--font-scale, 1));
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 30rpx;
  transition: all 0.25s;
  font-weight: 500;
}

.sub-tab.sub-tab-active {
  background: linear-gradient(135deg, #3D82D0 0%, #2B6CB0 100%);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(43, 108, 176, 0.28);
}

/* ========== 顶部统计 ========== */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 24rpx;
}

.header-total {
  font-size: calc(30rpx * var(--font-scale, 1));
  color: var(--color-text);
  font-weight: 500;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-hint {
  font-size: calc(26rpx * var(--font-scale, 1));
  color: var(--color-text-hint);
}

.manage-btn {
  font-size: calc(26rpx * var(--font-scale, 1));
  color: var(--color-primary);
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(43, 108, 176, 0.4);
  background: rgba(43, 108, 176, 0.06);
  font-weight: 500;
}

/* ========== 错题卡片 ========== */
.wrong-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  transition: all 0.25s ease;
  box-shadow: 0 6rpx 24rpx rgba(43, 108, 176, 0.08);
  border: 1rpx solid rgba(43, 108, 176, 0.22);
  border-left: 6rpx solid rgba(43, 108, 176, 0.5);
  position: relative;
}

.wrong-card.expanded {
  box-shadow: var(--shadow-hover);
}

/* 标签 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.card-tags {
  display: flex;
  gap: 16rpx;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.fav-btn {
  font-size: 24rpx;
  color: #B8860B;
  padding: 8rpx 20rpx;
  border: 2rpx solid rgba(184, 134, 11, 0.4);
  border-radius: 24rpx;
  background: rgba(255, 215, 0, 0.06);
}

.fav-btn.fav-active {
  color: #5B4500;
  background: linear-gradient(135deg, #FFE066 0%, #FFD700 100%);
  border-color: #D4A900;
  font-weight: 500;
}

.remove-btn {
  font-size: 24rpx;
  color: var(--color-danger);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(238, 10, 36, 0.06);
  flex-shrink: 0;
}

.tag {
  font-size: calc(24rpx * var(--font-scale, 1));
  padding: 8rpx 20rpx;
  border-radius: var(--radius-sm);
  line-height: 1.2;
  font-weight: 500;
}

.tag-subject {
  background: #e8f3ff;
  color: var(--color-primary);
}

.tag-difficulty {
  background: #fff5e6;
  color: var(--color-warning);
}

.tag-type {
  background: linear-gradient(135deg, #0ABAB5, #06d6a0);
  color: #fff;
  font-weight: 600;
}

.tag-source {
  background: #e8e0ff;
  color: #6c5ce7;
  font-weight: 500;
}

.tag-favorited {
  background: #fff9e6;
  color: #f5a623;
  font-size: 22rpx;
}

/* 题干 */
.card-question {
  font-size: calc(32rpx * var(--font-scale, 1));
  color: var(--color-text);
  line-height: 1.7;
  font-weight: 500;
}

/* 收起时的简短信息（两个小药丸） */
.card-brief {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--font-scale, 1));
}

.brief-wrong {
  color: var(--color-danger);
  background: #fef0f2;
  border-radius: 10rpx;
  padding: 8rpx 20rpx;
}

.brief-correct {
  color: var(--color-success);
  background: #e7f8ee;
  border-radius: 10rpx;
  padding: 8rpx 20rpx;
}

/* ========== 展开后的选项 ========== */
.card-options {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-border);
  background: #fafafa;
}

.opt-text {
  font-size: calc(30rpx * var(--font-scale, 1));
  color: var(--color-text-secondary);
  flex: 1;
}

.opt-mark {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  margin-left: 16rpx;
  font-weight: 500;
}

/* 正确答案 → 绿色 */
.card-option.opt-correct {
  border-color: var(--color-success);
  background: #e7f8ee;
}

.card-option.opt-correct .opt-text {
  color: var(--color-success);
}

.opt-mark-correct {
  background: var(--color-success);
  color: #fff;
}

/* 用户选错的 → 红色 */
.card-option.opt-wrong {
  border-color: var(--color-danger);
  background: #fef0f2;
}

.card-option.opt-wrong .opt-text {
  color: var(--color-danger);
}

.opt-mark-wrong {
  background: var(--color-danger);
  color: #fff;
}

/* ========== 解析 ========== */
.card-explanation {
  margin-top: 28rpx;
  background: #f9f9fb;
  border-radius: var(--radius-sm);
  padding: 28rpx;
  border-left: 8rpx solid var(--color-primary);
}

.explanation-label {
  display: block;
  font-size: calc(24rpx * var(--font-scale, 1));
  color: var(--color-primary);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.explanation-text {
  font-size: calc(30rpx * var(--font-scale, 1));
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* ========== 加载/空状态 ========== */
.loading-tip {
  text-align: center;
  padding: 32rpx 0;
  color: var(--color-text-hint);
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 110rpx 0 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ========== 空状态插画：一本翻开但空白的错题本 + 轨道光环 + 飘动星火 ========== */
.empty-illust {
  position: relative;
  width: 260rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 44rpx;
}

.empty-illust-ring {
  position: absolute;
  top: -30rpx;
  left: 50%;
  width: 240rpx;
  height: 240rpx;
  margin-left: -120rpx;
  border-radius: 50%;
  border: 3rpx dashed rgba(43, 108, 176, 0.32);
  animation: emptyRingSpin 22s linear infinite;
}

.empty-illust-ring-2 {
  top: -10rpx;
  width: 200rpx;
  height: 200rpx;
  margin-left: -100rpx;
  border-color: rgba(43, 108, 176, 0.18);
  border-style: solid;
  border-width: 2rpx;
  animation-duration: 14s;
  animation-direction: reverse;
}

@keyframes emptyRingSpin {
  to { transform: rotate(360deg); }
}

/* 错题本本体 */
.empty-illust-book {
  position: relative;
  z-index: 1;
  width: 160rpx;
  height: 196rpx;
  border-radius: 14rpx 20rpx 20rpx 14rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F1F7FC 100%);
  box-shadow:
    0 16rpx 32rpx rgba(43, 108, 176, 0.22),
    0 4rpx 10rpx rgba(0, 0, 0, 0.06),
    inset 4rpx 0 0 rgba(43, 108, 176, 0.06);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 22rpx 0 30rpx;
  overflow: hidden;
  animation: emptyBookFloat 3.6s ease-in-out infinite;
}

@keyframes emptyBookFloat {
  0%, 100% { transform: translateY(0) rotate(-1deg); }
  50%      { transform: translateY(-8rpx) rotate(1deg); }
}

.empty-illust-spine {
  position: absolute;
  top: 0;
  left: 0;
  width: 14rpx;
  height: 100%;
  background: linear-gradient(180deg, #5AB8F5 0%, #2B6CB0 100%);
  border-radius: 14rpx 0 0 14rpx;
}

.empty-illust-lines {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: flex-start;
  margin-top: 6rpx;
}

.empty-illust-line {
  width: 100rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(43, 108, 176, 0.28);
}

.empty-illust-line.short {
  width: 56rpx;
  background: rgba(43, 108, 176, 0.2);
}

.empty-illust-mark {
  position: absolute;
  right: 16rpx;
  bottom: 14rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #67D9A8 0%, #3CAE7C 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 6rpx 12rpx rgba(60, 174, 124, 0.4);
  animation: emptyCheckPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s backwards;
}

@keyframes emptyCheckPop {
  from { transform: scale(0); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}

.empty-illust-spark {
  position: absolute;
  color: rgba(43, 108, 176, 0.5);
  line-height: 1;
  animation: emptySparkFloat 3.4s ease-in-out infinite;
}

.empty-illust-spark.spark-1 { top: -10rpx; right: 10rpx;  font-size: 22rpx; }
.empty-illust-spark.spark-2 { bottom: 14rpx; left: -6rpx;  font-size: 18rpx; animation-delay: 1.1s; }
.empty-illust-spark.spark-3 { top: 60rpx;   right: -16rpx; font-size: 16rpx; animation-delay: 2.0s; color: rgba(43, 108, 176, 0.7); }

@keyframes emptySparkFloat {
  0%, 100% { transform: translate(0, 0); opacity: 0.5; }
  50%      { transform: translate(4rpx, -6rpx); opacity: 1; }
}

/* 文案 */
.empty-title {
  font-size: calc(34rpx * var(--font-scale, 1));
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: calc(26rpx * var(--font-scale, 1));
  color: var(--color-text-secondary);
  line-height: 1.6;
  letter-spacing: 1rpx;
  max-width: 480rpx;
  margin: 0 0 40rpx;
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #3D82D0 0%, #2B6CB0 100%);
  color: #fff;
  font-size: calc(30rpx * var(--font-scale, 1));
  font-weight: 500;
  padding: 20rpx 56rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 108, 176, 0.3);
}

.empty-btn-icon {
  font-size: 28rpx;
  line-height: 1;
}

/* ========== 底部按钮 ========== */
.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
  background: var(--color-primary);
  color: #ffffff;
  font-size: calc(34rpx * var(--font-scale, 1));
  font-weight: 500;
  padding: 28rpx 0;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* ========== 深色模式 ========== */
.wrong-page.dark {
  /* 深色背景：显式覆盖日间硬编码渐变，否则深模式下会发白 */
  background:
    radial-gradient(85% 40% at 50% -8%, rgba(74, 159, 224, 0.10) 0%, transparent 62%),
    linear-gradient(180deg, #20244A 0%, #1A1A2E 45%, #15152B 100%);
  --color-primary: #4A9FE0;
  --color-text: #E8E8F0;
  --color-text-secondary: #AABBDD;
  --color-text-hint: #7788AA;
  --color-bg: #1A1A2E;
  --color-card: #252540;
  --color-border: #353560;
}

.wrong-page.dark .card-option {
  background: #252540;
  border-color: #353560;
}

.wrong-page.dark .card-option.opt-correct {
  background: rgba(94, 234, 212, 0.08);
}

.wrong-page.dark .card-option.opt-wrong {
  background: rgba(255, 107, 107, 0.08);
}

.wrong-page.dark .card-explanation {
  background: #20203A;
}

.wrong-page.dark .tag-subject {
  background: rgba(74, 159, 224, 0.15);
}

.wrong-page.dark .tag-difficulty {
  background: rgba(255, 193, 7, 0.12);
}

.wrong-page.dark .tag-favorited {
  background: rgba(245, 166, 35, 0.15);
}

.wrong-page.dark .filter-panel {
  background: #252540;
  border-color: #353560;
}

.wrong-page.dark .filter-pill {
  background: #353560;
  color: #E8E8F0;
}

.wrong-page.dark .filter-pill.pill-active {
  background: linear-gradient(135deg, #4A9FE0 0%, #2B6CB0 100%);
  color: #ffffff;
}

/* 深色模式：分段选择器与药丸适配 */
.wrong-page.dark .wrong-tabs {
  background: rgba(37, 37, 64, 0.55);
  border-color: rgba(255, 255, 255, 0.08);
}

.wrong-page.dark .sub-tab {
  background: rgba(37, 37, 64, 0.55);
  border-color: rgba(255, 255, 255, 0.08);
  color: var(--color-text-secondary);
}

.wrong-page.dark .brief-wrong {
  background: rgba(255, 107, 107, 0.1);
}

.wrong-page.dark .brief-correct {
  background: rgba(94, 234, 212, 0.1);
}

.wrong-page.dark .empty-icon {
  background: linear-gradient(135deg, #2E3A55 0%, #26304A 100%);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.06);
}

.wrong-page.dark .batch-bar {
  background: transparent;
}

.wrong-page.dark .batch-select-all {
  background: #252540;
  border-color: #353560;
  color: #E8E8F0;
}

.wrong-page.dark .batch-fav {
  background: #252540;
  border-color: var(--color-primary);
}

/* 深色模式：取消收藏金色描边更亮一些，确保对比 */
.wrong-page.dark .batch-fav.batch-unfavorite {
  color: #F5C26B;
  border-color: #F5C26B;
  background: rgba(245, 194, 107, 0.14);
}

.wrong-page.dark .fav-btn {
  background: rgba(255, 215, 0, 0.08);
  border-color: rgba(184, 134, 11, 0.45);
}

.wrong-page.dark .remove-btn {
  background: rgba(255, 107, 107, 0.08);
}

.wrong-page.dark .manage-btn {
  background: rgba(74, 159, 224, 0.1);
  border-color: rgba(74, 159, 224, 0.4);
}

.wrong-page.dark .page-btn {
  background: #252540;
}

/* ========== 管理模式 ========== */
.wrong-card.item-selected {
  border-color: var(--color-primary);
  border-left-color: var(--color-primary);
  background: rgba(43, 108, 176, 0.06);
}

/* 选择框（管理模式）：absolute 定位在卡片右上角，与收藏页一致 */
.select-indicator {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  z-index: 1;
}

.select-indicator.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.check-icon {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

/* ========== 批量操作工具栏（内嵌式，与收藏页一致） ========== */
.batch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 24rpx;
  gap: 16rpx;
}

.batch-select-all {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: calc(28rpx * var(--font-scale, 1));
  border-radius: 32rpx;
  background: var(--color-card);
  color: var(--color-text);
  border: 2rpx solid var(--color-border);
  font-weight: 500;
}

.batch-fav {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 18rpx 0;
  font-size: calc(28rpx * var(--font-scale, 1));
  border-radius: 32rpx;
  background: var(--color-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  font-weight: 500;
  transition: all 0.22s ease;
}

.batch-fav-icon {
  font-size: 26rpx;
  line-height: 1;
}

/* 取消收藏状态：金色描边（提示移除动作，与新增收藏区分） */
.batch-fav.batch-unfavorite {
  color: #B8860B;
  border-color: #F5C26B;
  background: rgba(245, 194, 107, 0.08);
}

.batch-fav.batch-unfavorite .batch-fav-icon {
  color: #F5C26B;
}

.batch-delete {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: calc(28rpx * var(--font-scale, 1));
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF6B7A 0%, #EE0A24 100%);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 6rpx 18rpx rgba(238, 10, 36, 0.25);
}

.batch-fav.btn-disabled,
.batch-delete.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}
